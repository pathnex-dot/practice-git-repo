# parallel Builds
## jenkins pipeline - Parallel Build & Test

pipeline {
    agent any
    stages {
        stage('parallel tasks') {
            parallel {
                stage('Build') {
                    steps {
                        sh 'mvn clean compile'
                    }
                }
                stage('test'){
                    steps {
                        sh 'mvn test'
                    }
                }
            }
        }
    }
}


